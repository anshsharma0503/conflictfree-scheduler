PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/conflictfree?replicaSet=rs0
JWT_SECRET=replace-this-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# --- Background jobs (Phase M: BullMQ + Redis) ---
# Local: `docker compose up -d redis` (from the repository root).
# Redis Cloud: rediss://default:<password>@<host>:<port>
# Upstash:     rediss://default:<token>@<name>.upstash.io:6379
# Leave unset to run without notifications/reminders (the API still works).
# The Redis instance must use maxmemory-policy "noeviction".
REDIS_URL=redis://127.0.0.1:6379

# --- Scheduling assistant (Phase N: Google Gemini) ---
# Key from https://aistudio.google.com/apikey. Leave unset to hide the assistant.
GEMINI_API_KEY=
# Optional (defaults shown):
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite   # "none" disables the fallback
# GEMINI_TIMEOUT_MS=12000

# --- Optional (defaults shown in comments) ---
# Test database for `npm test`; defaults to MONGODB_URI with "_test" appended to the db name.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/conflictfree_test?replicaSet=rs0
# Extra browser origins allowed for credentialed API/Socket.io access (comma-separated).
# CORS_ORIGINS=
# JWT lifetime (default 7d) and auth cookie settings.
# JWT_EXPIRES_IN=7d
# COOKIE_SECURE=false            # defaults to true when NODE_ENV=production
# COOKIE_SAME_SITE=lax           # lax | strict | none (none requires COOKIE_SECURE=true)
# COOKIE_DOMAIN=
# LOG_LEVEL=info                 # debug | info | warn | error | silent
# Namespace for BullMQ keys (default conflictfree). Tests force "cftest", E2E "cfe2e".
# BULLMQ_PREFIX=conflictfree
# How often the reminder sweep runs, in ms (default 60000, minimum 1000).
# REMINDER_SWEEP_INTERVAL_MS=60000
# Redis used by `npm test`; defaults to REDIS_URL, then redis://127.0.0.1:6379.
# REDIS_URL_TEST=redis://127.0.0.1:6379
