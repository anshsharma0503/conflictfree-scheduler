PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/conflictfree?replicaSet=rs0
JWT_SECRET=replace-this-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# --- Optional (defaults shown in comments) ---
# Test database for `npm test`; defaults to MONGODB_URI with "_test" appended to the db name.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/conflictfree_test?replicaSet=rs0
# Extra browser origins allowed for credentialed API/Socket.io access (comma-separated).
# CORS_ORIGINS=
# JWT lifetime (default 7d) and auth cookie settings.
# JWT_EXPIRES_IN=7d
# COOKIE_SECURE=false            # defaults to true when NODE_ENV=production
# COOKIE_SAME_SITE=lax           # lax | strict | none (none requires COOKIE_SECURE=true)
# COOKIE_DOMAIN=
# LOG_LEVEL=info                 # debug | info | warn | error | silent
